    "kane:prepare": "node --import tsx server/prepare-kane.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "openai": "^6.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.18.6",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
